# ===========================================
# Darts Application Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Database (PostgreSQL)

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=dartsdb
POSTGRES_SSLMODE=disable


# JWT secret for signing tokens (generate with: openssl rand -base64 32)
JWT_SECRET=generate-a-random-32-char-string-here

TOKEN_TTL_HOURS=12

# -----------------
# CORS Configuration
# -----------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------
# Server
# -----------------
APP_PORT=8080
APP_ENV=dev

# -----------------
# Word Service (Compute Client)
# -----------------
# Type: grpc or http
WORD_SERVICE_TYPE=grpc
# For gRPC: localhost:50051, For HTTP: http://localhost:5000
WORD_SERVICE_URL=localhost:50051
WORD_SERVICE_TIMEOUT=30

# -----------------
# Logging
# -----------------
# Level: debug, info, warn, error, fatal, panic
LOG_LEVEL=debug
# Format: text or json
LOG_FORMAT=text
# Output: stdout, stderr, or file path
LOG_OUTPUT=stdout