# ===========================================
# Compute Client Configuration
# ===========================================
# Copy this file to .env

# Server mode: 'http' or 'grpc'
SERVER_MODE=grpc

# HTTP Server Settings (used when SERVER_MODE=http)
HTTP_HOST=0.0.0.0
HTTP_PORT=5000

# gRPC Server Settings (used when SERVER_MODE=grpc)
GRPC_PORT=50051

# Model Configuration
# Available models: glove-twitter-25, word2vec-google-news-300, etc.
# See: https://github.com/RaRe-Technologies/gensim-data
MODEL_NAME=glove-twitter-25
DEFAULT_LANGUAGE=en

# Monitoring interval in seconds
MONITORING_INTERVAL=60

# Logging directory
LOG_DIR=logs