# Frontend Environment Configuration
# Copy to appropriate .env.* file based on your deployment mode
#
# Deployment Modes:
#   npm run dev          → .env.development (local with backend)
#   npm run dev:mock     → mock API without backend
#   npm run build:pages  → .env.pages (GitHub Pages demo)
#   npm run build        → .env.production (Docker/GCloud)
#   docker-compose up    → runtime injection via .env.docker

VITE_API_URL=http://localhost:8080
VITE_USE_MOCK_API=false
VITE_BASE_PATH=/