# Example environment configuration
# Copy this file to .env.development or .env.production and modify as needed

# Use mock API (set to 'true' to use mock data, 'false' to connect to real backend)
VITE_USE_MOCK_API=true

# Backend API URL (only used when VITE_USE_MOCK_API is false)
VITE_API_URL=http://localhost:8080